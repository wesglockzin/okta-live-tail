# Copy to .env for local use. Never commit real values.

# --- Sign-in gate -----------------------------------------------------------
# Default is OIDC; the app refuses to start unless all of these are set.
# Set AUTH_MODE=none ONLY for local development: it turns the gate off.
# AUTH_MODE=none
FLASK_SECRET_KEY=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
APP_BASE_URL=
# At least one allow-list is required (comma-separated, case-insensitive).
OIDC_ALLOWED_EMAILS=
OIDC_ALLOWED_DOMAINS=

# --- Orgs -------------------------------------------------------------------
# Path of the org list (default: config.yaml next to the code).
# LIVE_TAIL_CONFIG=config.yaml
# Org shown first (default: default_env in the config file).
# DEFAULT_ENV=
# Per org, where <KEY> is the org key upper-cased (e.g. DEV):
#   OKTA_LIVE_TAIL_<KEY>_AUTH_MODE   oauth (default) or token
#   OKTA_LIVE_TAIL_<KEY>_API_TOKEN   SSWS token, when auth mode is token
#   OKTA_LIVE_TAIL_<KEY>_PRIVATE_KEY PEM (or base64 of it), when auth mode is oauth
#   OKTA_ADMIN_<KEY>_API_TOKEN       admin token for provision_app.py / bind_ro_admin.py

# --- Okta calls -------------------------------------------------------------
# Verify TLS certificates (default true). Use false only behind a TLS-inspecting proxy.
# OKTA_VERIFY_TLS=true
# POLL_INTERVAL_SECONDS=12
# BUFFER_SIZE=500
# DEDUP_RING_SIZE=5000
# INITIAL_LOOKBACK_MINUTES=5
# APPS_REFRESH_SECONDS=1800

# --- Server -----------------------------------------------------------------
# HOST=127.0.0.1   (the Docker image sets 0.0.0.0)
# PORT=5005        (the Docker image sets 8080)
